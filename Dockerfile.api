FROM python:3.11-slim
ENV PIP_DEFAULT_TIMEOUT=100 \
    PIP_RETRIES=10
WORKDIR /app
COPY requirements-docker.txt .
RUN pip install --no-cache-dir -r requirements-docker.txt
COPY src ./src
COPY api ./api
COPY models ./models
COPY data ./data
ENV PORT=8000
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"]
